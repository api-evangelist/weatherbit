          "request": {
            "name": "Weatherbit Returns Energy API Response - Given a Single Lat/lon.",
            "description": {
              "content": "Returns aggregate energy specific historical weather fields, over a specified time period. See https://www.weatherbit.io/api for API specific rate limits.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "history",
                "energy"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "lat",
                  "value": "<double>",
                  "description": "(Required) Latitude component of location."
                },
                {
                  "disabled": false,
                  "key": "lon",
                  "value": "<double>",
                  "description": "(Required) Longitude component of location."
                },
                {
                  "disabled": false,
                  "key": "start_date",
                  "value": "<string>",
                  "description": "(Required) Start Date (YYYY-MM-DD or YYYY-MM-DD:HH)."
                },
                {
                  "disabled": false,
                  "key": "end_date",
                  "value": "<string>",
                  "description": "(Required) End Date (YYYY-MM-DD or YYYY-MM-DD:HH)."
                },
                {
                  "disabled": false,
                  "key": "tp",
                  "value": "<string>",
                  "description": "Time period to aggregate by (daily, monthly)"
                },
                {
                  "disabled": false,
                  "key": "threshold",
                  "value": "<double>",
                  "description": "Temperature threshold to use to calculate degree days (default 18 C) "
                },
                {
                  "disabled": false,
                  "key": "units",
                  "value": "<string>",
                  "description": "Convert to units. Default Metric See <a target='blank' href='/api/requests'>units field description</a>"
                },
                {
                  "disabled": false,
                  "key": "key",
                  "value": "<string>",
                  "description": "(Required) Your registered API key."
                }
              ],
              "variable": []
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
