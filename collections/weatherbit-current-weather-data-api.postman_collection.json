                  "disabled": false,
                  "key": "lang",
                  "value": "<string>",
                  "description": "Language (Default: English) See <a target='blank' href='/api/requests'>language field description</a>"
                },
                {
                  "disabled": false,
                  "key": "key",
                  "value": "<string>",
                  "description": "(Required) Your registered API key."
                }
