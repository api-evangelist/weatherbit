                  "disabled": false,
                  "key": "tp",
                  "value": "<string>",
                  "description": "Time period (default: daily)"
                },
                {
                  "disabled": false,
                  "key": "key",
                  "value": "<string>",
                  "description": "(Required) Your registered API key."
                }
