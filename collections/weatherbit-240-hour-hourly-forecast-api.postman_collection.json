          "id": "588ca589-6b6e-45f2-bfe9-b88b7d02468e",
          "name": "Weatherbit Returns an Hourly Forecast - Given a Lat/lon.",
          "request": {
            "name": "Weatherbit Returns an Hourly Forecast - Given a Lat/lon.",
            "description": {
              "content": "Returns an hourly forecast, where each point represents a one hour period. Every point has a datetime string in the format \"YYYY-MM-DD:HH\". Time is UTC. \n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "forecast",
                "hourly"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "lat",
                  "value": "<double>",
                  "description": "Latitude component of location."
                },
                {
                  "disabled": false,
                  "key": "lon",
                  "value": "<double>",
                  "description": "Longitude component of location."
                },
                {
                  "disabled": false,
                  "key": "city_id",
                  "value": "<string>",
                  "description": "City ID. Example: 4487042"
                },
                {
                  "disabled": false,
                  "key": "city",
                  "value": "<string>",
                  "description": "City search.. Example - &city=Raleigh,NC or &city=Berlin,DE or city=Paris&country=FR"
                },
                {
                  "disabled": false,
                  "key": "postal_code",
                  "value": "<string>",
                  "description": "Postal Code. Example: 28546"
                },
                {
                  "disabled": false,
                  "key": "country",
                  "value": "<string>",
                  "description": "Country Code (2 letter) - to be used with postal_code."
                },
                {
                  "disabled": false,
                  "key": "station",
                  "value": "<string>",
                  "description": "Station Call ID."
                },
                {
                  "disabled": false,
                  "key": "units",
                  "value": "<string>",
                  "description": "Convert to units. Default Metric See <a target='blank' href='/api/requests'>units field description</a>"
                },
                {
                  "disabled": false,
                  "key": "lang",
                  "value": "<string>",
                  "description": "Language (Default: English) See <a target='blank' href='/api/requests'>language field description</a>"
                },
                {
                  "disabled": false,
                  "key": "hours",
                  "value": "<integer>",
                  "description": "Number of hours to return."
                },
                {
                  "disabled": false,
                  "key": "key",
                  "value": "<string>",
                  "description": "(Required) Your registered API key."
                }
              ],
              "variable": []
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": null
