      "item": [
        {
          "id": "df8dc28e-6e89-436d-a945-b5c014f8d246",
          "name": "Weatherbit Returns a Daily Forecast - Given Lat/Lon.",
          "request": {
            "name": "Weatherbit Returns a Daily Forecast - Given Lat/Lon.",
            "description": {
              "content": "Returns a daily forecast, where each point represents one day (24hr) period. Every point has a datetime string in the format \"YYYY-MM-DD\". One day begins at 00:00 UTC, and ends at 23:59 UTC. \n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "forecast",
                "daily"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "lat",
                  "value": "<double>",
                  "description": "Latitude component of location."
                },
                {
                  "disabled": false,
                  "key": "lon",
                  "value": "<double>",
                  "description": "Longitude component of location."
                },
                {
                  "disabled": false,
                  "key": "city_id",
                  "value": "<string>",
                  "description": "City ID. Example: 4487042"
                },
                {
                  "disabled": false,
                  "key": "city",
                  "value": "<string>",
                  "description": "City search.. Example - &city=Raleigh,NC or &city=Berlin,DE or city=Paris&country=FR"
                },
                {
                  "disabled": false,
                  "key": "postal_code",
                  "value": "<string>",
                  "description": "Postal Code. Example: 28546"
                },
                {
                  "disabled": false,
                  "key": "country",
                  "value": "<string>",
                  "description": "Country Code (2 letter) - to be used with postal_code."
                },
                {
                  "disabled": false,
                  "key": "station",
                  "value": "<string>",
                  "description": "Station Call ID."
                },
                {
                  "disabled": false,
                  "key": "days",
                  "value": "<integer>",
                  "description": "Number of days to return. Default 16."
                },
                {
                  "disabled": false,
                  "key": "units",
                  "value": "<string>",
                  "description": "Convert to units. Default Metric See <a target='blank' href='/api/requests'>units field description</a>"
                },
                {
                  "disabled": false,
                  "key": "lang",
                  "value": "<string>",
                  "description": "Language (Default: English) See <a target='blank' href='/api/requests'>language field description</a>"
                },
                {
                  "disabled": false,
                  "key": "key",
                  "value": "<string>",
                  "description": "(Required) Your registered API key."
                }
              ],
              "variable": []
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": null
          },
